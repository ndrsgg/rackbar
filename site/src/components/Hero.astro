---
import Code from './Code.astro';
import Icon from './Icon.astro';
import PanelMock from './PanelMock.astro';
import { links } from '../data/links';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">macOS menu bar app · for Hetzner Cloud</p>
      <h1 id="hero-title">Every server, across every project, one&nbsp;click away.</h1>
      <p class="lede">
        Rackbar lists the servers of every Hetzner Cloud project in the menu bar and writes an ssh config
        from the same list, so <code>ssh acme/web-1</code> and <code>ssh acme/<kbd>Tab</kbd></code> just work.
      </p>

      <div class="cta">
        <div class="cta-brew">
          <Code code="brew install --cask rackbar" label="the Homebrew install command" class="code-cta" />
          <span class="tag">Coming soon</span>
        </div>
        <a class="button" href={links.repo}>
          <Icon name="github" size={18} /> View on GitHub
        </a>
      </div>
      <p class="fine">read-only token · App Sandbox · macOS 27 · MIT · Mac App Store later</p>
    </div>

    <div class="desk">
      <div class="menubar" aria-hidden="true">
        <span class="mb-left">
          <b>Terminal</b><span>Shell</span><span>Edit</span><span>View</span>
        </span>
        <span class="mb-right">
          <span class="mb-item mb-active">
            <svg viewBox="0 0 18 18" width="16" height="16">
              <mask id="mb-leds">
                <rect width="18" height="18" fill="#fff" />
                <circle cx="4.75" cy="3" r="1" /><circle cx="4.75" cy="9" r="1" /><circle cx="4.75" cy="15" r="1" />
              </mask>
              <g fill="currentColor" mask="url(#mb-leds)">
                <rect x="2" y="1" width="14" height="4" rx="1.5" />
                <rect x="2" y="7" width="14" height="4" rx="1.5" />
                <rect x="2" y="13" width="14" height="4" rx="1.5" />
              </g>
            </svg>
          </span>
          <span class="mb-item">
            <svg viewBox="0 0 20 16" width="17" height="14"><path d="M10 13.6l1.7-2a2.6 2.6 0 0 0-3.4 0zM5.6 8.4l1.4 1.6a4.6 4.6 0 0 1 6 0l1.4-1.6a6.7 6.7 0 0 0-8.8 0zM2.9 5.3l1.4 1.6a8.7 8.7 0 0 1 11.4 0l1.4-1.6a10.8 10.8 0 0 0-14.2 0z" fill="currentColor" /></svg>
          </span>
          <span class="mb-clock">Tue 20 Oct&nbsp;&nbsp;9:41</span>
        </span>
      </div>

      <div class="panel-slot">
        <img
          src="/img/panel.png"
          width="380"
          height="640"
          alt="The Rackbar panel: servers grouped by project, each with a status dot, its IPv4, type and location."
          decoding="async"
          hidden
          onload="this.hidden=false;this.nextElementSibling.remove()"
          onerror="this.remove()"
        />
        <div
          class="panel-fallback"
          role="img"
          aria-label="The Rackbar panel: servers grouped by project, each with a status dot, its IPv4, type and location."
        >
          <PanelMock />
        </div>
      </div>
    </div>
  </div>
</section>
